  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "dev": "node scripts/build-css.mjs --watch & tsc -p tsconfig.build.json --watch",
    "check-types": "tsc --noEmit",
    "lint": "oxlint --config ../../.oxlintrc.json src && stylelint \"src/**/*.css\"",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --fix src && stylelint \"src/**/*.css\" --fix",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "test:package": "node --test scripts/package.test.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
