{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "jsx-a11y"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    // The rule suggests native tags for ARIA-pattern roles; a component
    // library implementing those patterns (tablist, switch on a native
    // input) is exactly where the suggestions are wrong.
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-noninteractive-tabindex": ["error", { "roles": ["tabpanel", "region"] }],
    "jsx-a11y/label-has-associated-control": [
      "error",
      {
        "controlComponents": [
          "Checkbox.Control",
          "Switch.Control",
          "Radio.Control",
          "Input",
          "Select",
          "Textarea",
          "Range"
        ],
        "depth": 3
      }
    ],
    "no-console": [
      "error",
      {
        "allow": ["error"]
      }
    ]
  },
  "ignorePatterns": ["dist", ".next", ".turbo", "node_modules", "storybook-static"],
  "overrides": [
    // list-style: none drops list semantics in some browsers (WebKit); every
    // component that strips markers restores them with role="list", so the
    // rule is off for core and the recipes rather than per file.
    {
      "files": [
        "**/packages/core/src/components/**/*.tsx",
        "**/apps/docs/src/recipes/**/Recipe.tsx"
      ],
      "rules": {
        "jsx-a11y/no-redundant-roles": "off"
      }
    },
    // A docs or gallery page passes the element to render into through core's
    // render prop (render={<h2 />}, render={<a href />}); the part supplies the
    // content, so the empty element is not an empty heading, link or control.
    {
      "files": [
        "**/apps/ui/src/content/*.tsx",
        "**/apps/docs/src/content/components/**/*.tsx",
        "**/apps/docs/src/recipes/**/Recipe.tsx"
      ],
      "rules": {
        "jsx-a11y/heading-has-content": "off",
        "jsx-a11y/anchor-has-content": "off",
        "jsx-a11y/control-has-associated-label": "off",
        "jsx-a11y/label-has-associated-control": "off"
      }
    },
    // A sandbox permissive enough for a video or map player is no sandbox; the consumer passes one for untrusted sources.
    {
      "files": ["**/Embed/Embed.tsx", "**/apps/docs/src/recipes/**/embed-*/Recipe.tsx"],
      "rules": {
        "react/iframe-missing-sandbox": "off"
      }
    },
    // Tests and stories render fixtures: static-array keys, focus probes,
    // and bare interactive stubs are deliberate there.
    {
      "files": ["**/*.test.tsx", "**/*.test.ts", "**/*.stories.tsx"],
      "rules": {
        "react/jsx-key": "off",
        "jsx-a11y/no-autofocus": "off",
        "jsx-a11y/control-has-associated-label": "off",
        "jsx-a11y/anchor-has-content": "off",
        "jsx-a11y/heading-has-content": "off"
      }
    },
    // A native checkbox with role="switch" exposes its checked state as
    // aria-checked through the host language; the rule can't see that
    // mapping and would demand a redundant (and drift-prone) attribute.
    {
      "files": ["**/Switch/control/SwitchControl.tsx"],
      "rules": {
        "jsx-a11y/role-has-required-aria-props": "off"
      }
    },
    // Roving tabindex: the tablist element carries the keydown handler but
    // is never itself a tab stop — the tabs inside it are.
    {
      "files": ["**/Tabs/list/TabsList.tsx", "**/renderer/components/Preview.tsx"],
      "rules": {
        "jsx-a11y/interactive-supports-focus": "off"
      }
    },
    // The toast region listens for hover/focus to pause dismissal timers —
    // a convenience on a live region, not an interactive control.
    {
      "files": ["**/Toast/viewport/ToastViewport.tsx"],
      "rules": {
        "jsx-a11y/no-noninteractive-element-interactions": "off"
      }
    },
    // The modal example demonstrates initial-focus placement, which is
    // what autofocus is for inside a just-opened dialog.
    {
      "files": ["**/content/components/modal/demos.tsx"],
      "rules": {
        "jsx-a11y/no-autofocus": "off"
      }
    },
    // Highlighted code lines have no identity beyond their position and the
    // list rebuilds wholesale on change — index keys are the correct keys.
    {
      "files": ["**/renderer/components/CodeBlock.tsx"],
      "rules": {
        "react/no-array-index-key": "off"
      }
    },
    // The CLI's output is the console.
    {
      "files": ["**/packages/cli/**/*.mjs"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
