{
  "name": "@loamui/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-css.mjs && tsx --tsconfig scripts/tsconfig.export.json scripts/build-recipes.mts && tsx --tsconfig scripts/tsconfig.export.json scripts/export-markdown.mts",
    "dev": "node scripts/sync-css.mjs --watch & next dev --port 3007",
    "prebuild": "node scripts/sync-css.mjs && tsx --tsconfig scripts/tsconfig.export.json scripts/build-recipes.mts && tsx --tsconfig scripts/tsconfig.export.json scripts/export-markdown.mts",
    "build": "next build",
    "start": "next start --port 3007",
    "check-types": "tsc --noEmit",
    "lint": "oxlint --config ../../.oxlintrc.json src && stylelint \"src/**/*.css\"",
    "build-recipes": "tsx --tsconfig scripts/tsconfig.export.json scripts/build-recipes.mts",
    "test": "vitest run"
  },
  "dependencies": {
    "@loamui/core": "workspace:*",
    "@tabler/icons-react": "^3.46.0",
    "next": "^16.2.2",
    "prism-react-renderer": "^2.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/mdast": "4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "22.12.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-phrasing": "4.1.0",
    "mdast-util-to-markdown": "2.1.2",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "tsx": "^4.23.12",
    "typescript": "5.9.2",
    "unified": "11.0.5",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vitest-axe": "^0.1.0"
  }
}
